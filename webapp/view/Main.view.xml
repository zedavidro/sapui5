<mvc:View


	controllerName="de.unigoettingen.dashboardapp.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">


  <Page
  id="page"
  showHeader="false">

	<content>
	  <Select change="onYearChange" class="sapUiSmallMargin">
  	  <items>
      <core:Item key="2024" text="2024"/>
      <core:Item key="2025" text="2025"/>
      <core:Item key="2026" text="2026"/>
	  <core:Item key="alle" text="alle"/>
  	  </items>
	  </Select>

		<!--- KPIs -->
	  <HBox justifyContent="SpaceAround" class="sapUiSmallMargin">

  		<VBox class="kpi-card">
        <Text text="Kosten" class="kpi-title"/>
        <Text text="{
          path: 'dashboard>/kpis/costs',
          formatter: '.formatEuro'
        }" class="kpi-value"/>
      </VBox>

      <VBox class="kpi-card">
        <Text text="Erträge" class="kpi-title"/>
        <Text text="{
          path: 'dashboard>/kpis/revenue',
          formatter: '.formatEuro'
        }" class="kpi-value"/>
      </VBox>

      <VBox class="kpi-card">
        <Text text="Ergebnis" class="kpi-title"/>
        <Text text="{
          path: 'dashboard>/kpis/result',
          formatter: '.formatEuro'
        }" class="kpi-value"/>
      </VBox>

    </HBox>

      <viz:VizFrame
        id="idPieChart"
        vizType="column"
        width="100%"
        height="400px"
        vizProperties="{
        title: {
        text: 'Kostenaufteilung nach Kategorie',
        visible: true
        },
        legend: { visible: false }
        }">

        <viz:dataset>
          <viz.data:FlattenedDataset data="{/costGroups}">
            <viz.data:dimensions>
              <viz.data:DimensionDefinition
                name="Cost Group"
                value="{name}" />
            </viz.data:dimensions>

            <viz.data:measures>
              <viz.data:MeasureDefinition
                name="Amount"
                value="{value}" />
            </viz.data:measures>
          </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
          <viz.feeds:FeedItem
            uid="valueAxis"
            type="Measure"
            values="Amount"/>
          <viz.feeds:FeedItem
            uid="categoryAxis"
            type="Dimension"
            values="Cost Group"/>
        </viz:feeds>

      </viz:VizFrame>

      <!-- Yearly Trend Line Chart -->
      <viz:VizFrame
        id="idLineChart"
        vizType="line"
        width="100%"
        height="400px"
        vizProperties="{
          title: {
            text: 'Finanzieller Trend über die Jahre (2024 - 2026)',
            visible: true
          },
          legend: {
            visible: true
          },
          plotArea: {
            dataLabel: {
              visible: true
            },
            lineStyle: {
              rules: [{
                dataContext: { 'Betrag': '*' },
                properties: { width: 4 }
              }]
            }
          }
        }"
        class="sapUiMediumMarginTop">

        <viz:dataset>
          <viz.data:FlattenedDataset data="{/yearlyTrend}">
            <viz.data:dimensions>
              <viz.data:DimensionDefinition
                name="Jahr"
                value="{jahr}" />
              <viz.data:DimensionDefinition
                name="Kategorie"
                value="{kategorie}" />
            </viz.data:dimensions>

            <viz.data:measures>
              <viz.data:MeasureDefinition
                name="Betrag"
                value="{wert}" />
            </viz.data:measures>
          </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
          <viz.feeds:FeedItem
            uid="valueAxis"
            type="Measure"
            values="Betrag"/>
          <viz.feeds:FeedItem
            uid="categoryAxis"
            type="Dimension"
            values="Jahr"/>
          <viz.feeds:FeedItem
            uid="color"
            type="Dimension"
            values="Kategorie"/>
        </viz:feeds>

      </viz:VizFrame>

    </content>
	</Page>

</mvc:View>
