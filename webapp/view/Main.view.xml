<!--
  Main.view.xml — Lehrstuhlfinanzen-Seite ("Finanzen"-Reiter, Route "finanzen")
  - Zeigt die eigenen Finanzdaten des eingeloggten Lehrstuhls: KPI-Kacheln (Kosten/Erträge/
    Ergebnis) sowie zwei Diagramme (Kostenaufteilung nach Kategorie, Trend über 3 Jahre)
  - Daten kommen aus /api/finanzen (echte SQLite-Tabelle) und werden im Controller
    (Main.controller.js) aggregiert
  - Dies ist die Standard-Landing-Page für Nutzer mit Zugriffsrecht 0/1 (nur Lehrstuhlebene)
-->
<mvc:View


	controllerName="de.unigoettingen.dashboardapp.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
  core:require="{
    formatter: 'de/unigoettingen/dashboardapp/model/formatter'
}">


  <Page
  id="page"
  showHeader="false">

	<content>
    <!-- Jahresauswahl: löst onYearChange aus, das die Aggregation neu berechnet -->
    <Toolbar design="Transparent" class="sapUiSmallMargin">
        <Title text="Analysejahr wählen:" class="sapUiTinyMarginEnd"/>
	  <Select change="onYearChange" selectedKey="2026" class="sapUiSmallMargin">
  	  <items>
      <core:Item key="2024" text="2024"/>
      <core:Item key="2025" text="2025"/>
      <core:Item key="2026" text="2026"/>
	  <core:Item key="alle" text="alle"/>
  	  </items>
	  </Select>
      </Toolbar>

		<!--- KPIs -->
    <!-- KPI-Kacheln, gebunden an das Modell "dashboard" (siehe _updateAggregates im Controller) -->
	  <HBox justifyContent="SpaceAround" class="sapUiSmallMargin">

      <GenericTile header="Kosten" class="sapUiTinyMargin" frameType="TwoByOne">
        <TileContent
          footer="+3,8% ggü. Vorjahr">
          <NumericContent
            value="{
              path: 'dashboard>/kpis/costs',
              formatter: 'formatter.formatNumber'
            }"
            scale="{
        path: 'dashboard>/kpis/costs',
        formatter: 'formatter.formatScale'
    }"
            valueColor="Error" />
        </TileContent>
      </GenericTile>

      <GenericTile header="Erträge" class="sapUiTinyMargin" frameType="TwoByOne">
        <TileContent
          footer="-11,2% ggü. Vorjahr">
          <NumericContent
            value="{
              path: 'dashboard>/kpis/revenue',
              formatter: 'formatter.formatNumber'
            }"
            scale="{
        path: 'dashboard>/kpis/revenue',
        formatter: 'formatter.formatScale'
    }"
            valueColor="Good" />
        </TileContent>
      </GenericTile>

      <GenericTile header="Ergebnis" class="sapUiTinyMargin" frameType="TwoByOne">
        <TileContent
          footer="Vorjahr: +8,4 Mio. €">
          <NumericContent
            value="{
              path: 'dashboard>/kpis/result',
              formatter: 'formatter.formatNumber'
            }"
            scale="{
        path: 'dashboard>/kpis/result',
        formatter: 'formatter.formatScale'
    }"
            valueColor="Neutral" />
        </TileContent>
      </GenericTile>

    </HBox>

      <!-- Säulendiagramm: Kostenaufteilung nach Kategorie (gebunden an /costGroups) -->
      <viz:VizFrame
        id="idPieChart"
        vizType="column"
        width="100%"
        height="400px"
        vizProperties="{
        title: {
        text: 'Kostenaufteilung nach Kategorie',
        visible: true
        },
        legend: { visible: false }
        }">

        <viz:dataset>
          <viz.data:FlattenedDataset data="{/costGroups}">
            <viz.data:dimensions>
              <viz.data:DimensionDefinition
                name="Cost Group"
                value="{name}" />
            </viz.data:dimensions>

            <viz.data:measures>
              <viz.data:MeasureDefinition
                name="Amount"
                value="{value}" />
            </viz.data:measures>
          </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
          <viz.feeds:FeedItem
            uid="valueAxis"
            type="Measure"
            values="Amount"/>
          <viz.feeds:FeedItem
            uid="categoryAxis"
            type="Dimension"
            values="Cost Group"/>
        </viz:feeds>

      </viz:VizFrame>

      <!-- Yearly Trend Line Chart -->
      <!--
        Liniendiagramm: Kosten/Erträge/Ergebnis über 2024–2026 (gebunden an /yearlyTrend).
        colorPalette legt die Linienfarben fest (rot/grün/dunkel, passend zu den KPI-Kacheln
        Error/Good/Neutral). renderComplete="onTrendChartRenderComplete" färbt zusätzlich die
        Datenpunkt-Beschriftungen ein und rückt sie auseinander (siehe Controller-Kommentar dort),
        da sap.viz das nicht deklarativ pro Serie unterstützt.
      -->
      <viz:VizFrame
        id="idLineChart"
        vizType="line"
        width="100%"
        height="400px"
        vizProperties="{
          title: {
            text: 'Finanzieller Trend über die Jahre (2024 - 2026)',
            visible: true
          },
          legend: {
            visible: true
          },
          plotArea: {
            colorPalette: ['#aa0808', '#256f3a', '#131e29'],
            dataLabel: {
              visible: true
            },
            lineStyle: {
              rules: [{
                dataContext: { 'Betrag': '*' },
                properties: { width: 4 }
              }]
            }
          }
        }"
        renderComplete="onTrendChartRenderComplete"
        class="sapUiMediumMarginTop">

        <viz:dataset>
          <viz.data:FlattenedDataset data="{/yearlyTrend}">
            <viz.data:dimensions>
              <viz.data:DimensionDefinition
                name="Jahr"
                value="{jahr}" />
              <viz.data:DimensionDefinition
                name="Kategorie"
                value="{kategorie}" />
            </viz.data:dimensions>

            <viz.data:measures>
              <viz.data:MeasureDefinition
                name="Betrag"
                value="{wert}" />
            </viz.data:measures>
          </viz.data:FlattenedDataset>
        </viz:dataset>

        <viz:feeds>
          <viz.feeds:FeedItem
            uid="valueAxis"
            type="Measure"
            values="Betrag"/>
          <viz.feeds:FeedItem
            uid="categoryAxis"
            type="Dimension"
            values="Jahr"/>
          <viz.feeds:FeedItem
            uid="color"
            type="Dimension"
            values="Kategorie"/>
        </viz:feeds>

      </viz:VizFrame>

    </content>
	</Page>

</mvc:View>
