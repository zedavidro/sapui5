<mvc:View
    controllerName="de.unigoettingen.dashboardapp.controller.Auth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true">

    <App id="loginApp">
        <pages>
            <Page title="Login" showHeader="false" class="login-page-minimal">
                <content>
                    <FlexBox
                        alignItems="Center"
                        justifyContent="Center"
                        height="100%"
                        class="login-wrapper-minimal">

                        <VBox class="login-card-minimal sapUiLargePadding" alignItems="Center" width="400px">

                            <!-- Header Logo & Brand -->
                            <Image src="img/Logo_Uni_Göttingen_2022.png" width="300px" alt="Logo" class="loginLogo" />

                            <Title text="Management-Dashboard" titleStyle="H2" class="login-portal-title-minimal sapUiTinyMarginBottom" />
                            <Text text="Integriertes Portal für Finanzen, Personal &amp; Publikationen" class="login-subtitle-minimal sapUiMediumMarginBottom" />

                            <!-- Form Area (Centered) -->
                            <VBox width="100%" class="login-form-area-minimal sapUiMediumMarginTop" alignItems="Center">

                                <Input
                                    id="userField"
                                    value="{login>/username}"
                                    placeholder="Benutzername"
                                    class="login-input-minimal sapUiSmallMarginBottom" />

                                <Input
                                    id="pwField"
                                    value="{login>/password}"
                                    type="Password"
                                    placeholder="Passwort"
                                    class="login-input-minimal sapUiMediumMarginBottom"
                                    submit=".onLoginPress" />

                                <Button
                                    text="Anmelden"
                                    type="Emphasized"
                                    width="100%"
                                    press=".onLoginPress"
                                    class="login-button-minimal sapUiMediumMarginBottom" />

                            </VBox>

                            <!-- Security Notice / Footer -->
                            <Text text="Internes System • Zugriff nur für autorisierte Mitarbeiter" class="login-footer-minimal sapUiMediumMarginTop" />

                        </VBox>
                    </FlexBox>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
