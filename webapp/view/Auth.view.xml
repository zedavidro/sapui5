<!--
  Auth.view.xml — Login-Seite
  - Erste Seite, die ein nicht eingeloggter Nutzer sieht (Route "" / "login")
  - Enthält nur ein einfaches Formular: Logo, Titel, Benutzername/Passwort, Anmelden-Button
  - Kein Zugriff auf die Seitenleiste/Reiter der Shell (App.view.xml blendet diese für die
    Login-Route extra aus, siehe App.controller.js/onRouteMatched)
  - Logik (Login-Prüfung, Weiterleitung je nach Rolle) liegt in Auth.controller.js
-->
<mvc:View
    controllerName="de.unigoettingen.dashboardapp.controller.Auth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <!-- Eigene kleine App-Instanz nur für die Login-Seite (kein ToolPage-Rahmen nötig) -->
    <App id="loginApp">
        <pages>
            <Page title="Login" showHeader="false" backgroundDesign="Solid">
                <content>
                    <!-- Zentriert den gesamten Login-Kasten horizontal und vertikal auf der Seite -->
                    <FlexBox
                        alignItems="Center"
                        justifyContent="Center"
                        height="100%">

                        <VBox alignItems="Center" width="24rem" class="sapUiLargeMargin">

                            <!-- Logo -->
                            <Image src="img/Logo_Uni_Goettingen_2022.png" width="300px" alt="Logo"
                                   class="sapUiMediumMarginBottom" />

                            <!-- Title & Subtitle -->
                            <Title text="Management-Dashboard" level="H2"
                                   class="sapUiTinyMarginBottom" titleStyle="H2" />
                            <Label text="Integrierte Analyse von Finanzen &amp; Personal"
                                   class="sapUiSmallMarginBottom sapThemeText"
                                   textAlign="Center" wrapping="true" />

                            <!-- Login Form -->
                            <!--
                              Beide Eingabefelder sind an das View-Modell "login" gebunden
                              (username/password), das im Controller (onInit) angelegt und bei
                              jedem erneuten Aufruf der Login-Seite zurückgesetzt wird.
                            -->
                            <VBox width="100%" class="sapUiMediumMarginTop">

                                <Label text="Benutzername" labelFor="userField"
                                       class="sapUiTinyMarginBottom" />
                                <Input
                                    id="userField"
                                    value="{login>/username}"
                                    placeholder="Benutzername eingeben"
                                    class="sapUiSmallMarginBottom" />

                                <Label text="Passwort" labelFor="pwField"
                                       class="sapUiTinyMarginBottom" />
                                <Input
                                    id="pwField"
                                    value="{login>/password}"
                                    type="Password"
                                    placeholder="Passwort eingeben"
                                    class="sapUiMediumMarginBottom"
                                    submit=".onLoginPress" />

                                <!-- Anmelden per Klick ODER durch Enter-Taste im Passwort-Feld (submit oben) -->
                                <Button
                                    text="Anmelden"
                                    type="Emphasized"
                                    width="100%"
                                    press=".onLoginPress" />

                            </VBox>

                            <!-- Footer -->
                            <Label text="Version 1.0 • Prototyp"
                                   class="sapUiMediumMarginTop sapThemeLightText"
                                   design="Light" wrapping="true" textAlign="Center" />

                        </VBox>
                    </FlexBox>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
