<mvc:View
    controllerName="de.unigoettingen.dashboardapp.controller.Auth"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <App id="loginApp">
        <pages>
            <Page title="Login" showHeader="false" backgroundDesign="Solid">
                <content>
                    <FlexBox
                        alignItems="Center"
                        justifyContent="Center"
                        height="100%">

                        <VBox alignItems="Center" width="24rem" class="sapUiLargeMargin">

                            <!-- Logo -->
                            <Image src="img/Logo_Uni_Goettingen_2022.png" width="300px" alt="Logo"
                                   class="sapUiMediumMarginBottom" />

                            <!-- Title & Subtitle -->
                            <Title text="Management-Dashboard" level="H2"
                                   class="sapUiTinyMarginBottom" titleStyle="H2" />
                            <Label text="Integriertes Portal für Finanzen, Personal &amp; Publikationen"
                                   class="sapUiSmallMarginBottom sapThemeText"
                                   textAlign="Center" wrapping="true" />

                            <!-- Login Form -->
                            <VBox width="100%" class="sapUiMediumMarginTop">

                                <Label text="Benutzername" labelFor="userField"
                                       class="sapUiTinyMarginBottom" />
                                <Input
                                    id="userField"
                                    value="{login>/username}"
                                    placeholder="Benutzername eingeben"
                                    class="sapUiSmallMarginBottom" />

                                <Label text="Passwort" labelFor="pwField"
                                       class="sapUiTinyMarginBottom" />
                                <Input
                                    id="pwField"
                                    value="{login>/password}"
                                    type="Password"
                                    placeholder="Passwort eingeben"
                                    class="sapUiMediumMarginBottom"
                                    submit=".onLoginPress" />

                                <Button
                                    text="Anmelden"
                                    type="Emphasized"
                                    width="100%"
                                    press=".onLoginPress" />

                            </VBox>

                            <!-- Footer -->
                            <Label text="Internes System • Zugriff nur für autorisierte Mitarbeiter"
                                   class="sapUiMediumMarginTop sapThemeLightText"
                                   design="Light" wrapping="true" textAlign="Center" />

                        </VBox>
                    </FlexBox>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
