<mvc:View
    controllerName="de.unigoettingen.dashboardapp.controller.PB"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="page"
        showHeader="false">

        <content>
            <!-- Header -->
            <VBox
                justifyContent="Center"
                alignItems="Center"
                class="sapUiLargeMargin">

                <Title text="Publikationsdaten" level="H2" class="sapUiSmallMarginBottom"/>
                <Text text="Übersicht über Veröffentlichungen nach Status und Jahr"/>
            </VBox>

            <!-- Year Selector -->
            <Select
                change="onYearChange"
                selectedKey="{dashboard>/selectedYear}"
                class="sapUiSmallMargin">

                <items>
                    <core:Item key="2023" text="2023"/>
                    <core:Item key="2024" text="2024"/>
                    <core:Item key="2025" text="2025"/>
                    <core:Item key="2026" text="2026"/>
                    <core:Item key="alle" text="alle"/>
                </items>
            </Select>

            <!-- KPIs -->
            <HBox justifyContent="SpaceAround" class="sapUiSmallMargin">

                <GenericTile header="Veröffentlicht" class="sapUiTinyMargin">
                    <TileContent>
                        <NumericContent value="{dashboard>/kpis/published}" valueColor="Good" />
                    </TileContent>
                </GenericTile>

                <GenericTile header="Under Review" class="sapUiTinyMargin">
                    <TileContent>
                        <NumericContent value="{dashboard>/kpis/underReview}" valueColor="Critical" />
                    </TileContent>
                </GenericTile>

                <GenericTile header="In Vorbereitung" class="sapUiTinyMargin">
                    <TileContent>
                        <NumericContent value="{dashboard>/kpis/inPreparation}" valueColor="Neutral" />
                    </TileContent>
                </GenericTile>

            </HBox>

        </content>

    </Page>

</mvc:View>