<mvc:View
	controllerName="de.unigoettingen.dashboardapp.controller.Unifinanzen"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	core:require="{
		formatter: 'de/unigoettingen/dashboardapp/model/formatter'
	}">

  <Page
      title="Universitätsfinanzen"
      id="unifinanzenPage"
      showNavButton="false">

	<content>
      <!-- Dynamic Title and Trend Icon -->
      <HBox alignItems="Center" class="sapUiResponsiveMargin">
          <Title id="chartDynamicTitle" text="Universitätsdaten (Gesamt)" level="H2" class="sapUiTinyMarginEnd" />
          <core:Icon id="chartTrendIcon" src="sap-icon://trend-up" size="1.5rem" color="Positive" visible="false" />
      </HBox>

      <!-- Bar Chart displaying the unifinanzen data grouped by year -->
      <viz:VizFrame
        id="unifinanzenChart"
        vizType="column"
        width="100%"
        height="500px"
        class="sapUiResponsiveMargin"
        vizProperties="{
            title: { visible: false },
            legend: { visible: false },
            plotArea: {
                dataLabel: { visible: true },
                window: { start: 'firstDataPoint', end: 'lastDataPoint' }
            }
        }">
        <viz:dataset>
          <viz.data:FlattenedDataset data="{unifinanzen>/data}">
            <viz.data:dimensions>
              <viz.data:DimensionDefinition name="Jahr" value="{unifinanzen>jahr}" />
            </viz.data:dimensions>
            <viz.data:measures>
              <viz.data:MeasureDefinition name="Wert" value="{unifinanzen>wert}" />
            </viz.data:measures>
          </viz.data:FlattenedDataset>
        </viz:dataset>
        <viz:feeds>
          <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Wert"/>
          <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Jahr"/>
        </viz:feeds>
      </viz:VizFrame>
    </content>
  </Page>

</mvc:View>
