<!--
  Paquin1.view.xml — Fakultätsfinanzen-Seite (Route "fakultaetsfinanzen")
  - Trotz des Dateinamens "Paquin1" ist dies die tatsächliche Fakultätsebene: laut
    manifest.json ist die Route "fakultaetsfinanzen" auf DIESEN View gemappt
    (der gleichnamige View "Fakultaetsfinanzen.view.xml" ist dagegen unbenutzt)
  - Drei Reiter: "Finanzen" (Budget/Grundmittel/Drittmittel + Budgetaufstellung),
    "Personal" (Kennzahlen der Fakultät) und "Kostenstellen" (Lehrstuhl- und Gebäudeübersicht)
  - Alle Daten sind Platzhalter-Daten je Geschäftsjahr, die im Controller (Paquin1.controller.js)
    aus fest hinterlegten Basiswerten proportional hoch-/runterskaliert werden
-->
<mvc:View
	controllerName="de.unigoettingen.dashboardapp.controller.Paquin1"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
		core:require="{
		formatter: 'de/unigoettingen/dashboardapp/model/formatter'
	}">

	<Page
		id="paquin1Page"
		showNavButton="false">

		<customHeader>
			<Bar>
				<contentLeft>
					<HBox alignItems="Center">
						<core:Icon src="sap-icon://education" size="1rem" class="sapUiTinyMarginEnd"/>
						<Title text="Fakultätsfinanzen" class="sapUiTinyMarginTop"/>
					</HBox>
				</contentLeft>

				<!-- Reiterleiste: steuert, welcher Inhaltsblock unten sichtbar ist (view>/selectedTab) -->
				<contentMiddle>
					<IconTabHeader id="navTabBar" selectedKey="pr_fi" select="onTabSelect">
						<items>
							<IconTabFilter text="Finanzen" key="pr_fi"/>
							<IconTabFilter text="Personal" key="pr_hr"/>
							<IconTabFilter text="Kostenstellen" key="pr_ks"/>
						</items>
					</IconTabHeader>
				</contentMiddle>

				<contentRight>
					<!-- Jahresauswahl: löst onYearChange aus (skaliert alle Werte auf das gewählte Jahr um) -->
					<Select change="onYearChange" selectedKey="2026" class="sapUiSmallMargin">
						<items>
							<core:Item key="2024" text="2024"/>
							<core:Item key="2025" text="2025"/>
							<core:Item key="2026" text="2026"/>
						</items>
					</Select>
				</contentRight>
			</Bar>
		</customHeader>

		<content>

			<!--- KPI-Karten: Kontoübersicht -->
			<!-- Nur im Reiter "Finanzen" sichtbar: 6 Kacheln mit den wichtigsten Kennzahlen -->
			<HBox justifyContent="SpaceAround" class="sapUiSmallMargin" wrap="Wrap" visible="{= ${view>/selectedTab} === 'pr_fi' }">

    <GenericTile
    header="Budget"
    class="sapUiTinyMargin">

    <!-- Fußzeile zeigt die Veränderung ggü. Vorjahr (formatter.formatBudgetFooter, siehe formatter.js) -->
    <TileContent
        footer="{
            parts: [
                { path: 'fakFinanzen>/kpis/budget' },
                { path: 'fakFinanzen>/kpis/prevBudget' }
            ],
            formatter: 'formatter.formatBudgetFooter'
        }">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/budget',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/budget',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Verausgabt"
    class="sapUiTinyMargin">

    <TileContent
        footer="82,4% verausgabt">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/ausgabenIst',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/ausgabenIst',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Error"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Obligo"
    class="sapUiTinyMargin">

    <!-- Fußzeile: Anteil des Obligos am Budget (formatter.formatObligoFooter) -->
    <TileContent
        footer="{
			parts: [
				{ path: 'fakFinanzen>/kpis/obligo' },
				{ path: 'fakFinanzen>/kpis/budget' }
			],
			formatter: 'formatter.formatObligoFooter'
		}">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/obligo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/obligo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Critical"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Verfügbar"
    class="sapUiTinyMargin">

    <!-- Fußzeile: verbleibender Budgetspielraum in % (formatter.formatRestFooter) -->
    <TileContent
        footer="{
			parts: [
				{ path: 'fakFinanzen>/kpis/restVerfuegbarkeit' },
				{ path: 'fakFinanzen>/kpis/budget' }
			],
			formatter: 'formatter.formatRestFooter'
		}">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/restVerfuegbarkeit',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/restVerfuegbarkeit',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Good"/>
    </TileContent>

</GenericTile>


<!--
  Grundmittel/Drittmittel: Überschuss (grün) oder Defizit (rot) je Budgetart, gebunden an
  das Modell "budgetarten" (siehe _updateTableData im Controller). Farbe/Statustext werden
  komplett aus dem Saldo-Vorzeichen berechnet (formatter.formatBudgetartStatus/-Color).
-->
<GenericTile
    header="Grundmittel"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
            path: 'budgetarten>/grundmittel/saldo',
            formatter: 'formatter.formatBudgetartStatus'
        }">

        <NumericContent
            value="{
                path: 'budgetarten>/grundmittel/saldo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'budgetarten>/grundmittel/saldo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="{
                path: 'budgetarten>/grundmittel/saldo',
                formatter: 'formatter.formatBudgetartColor'
            }"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Drittmittel"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
            path: 'budgetarten>/drittmittel/saldo',
            formatter: 'formatter.formatBudgetartStatus'
        }">

        <NumericContent
            value="{
                path: 'budgetarten>/drittmittel/saldo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'budgetarten>/drittmittel/saldo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="{
                path: 'budgetarten>/drittmittel/saldo',
                formatter: 'formatter.formatBudgetartColor'
            }"/>
    </TileContent>

</GenericTile>

</HBox>

			<!-- Nur im Reiter "Personal" sichtbar: 4 Kennzahlen-Kacheln zur Personalsituation der Fakultät -->
			<HBox justifyContent="SpaceAround" class="sapUiSmallMargin" wrap="Wrap" visible="{= ${view>/selectedTab} === 'pr_hr' }">

    <GenericTile
    header="Kopfzahl (Gesamt)"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{fakPersonal>/kpis/headcount}"
            scale="Personen"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Personalbestand (VZÄ)"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{path: 'fakPersonal>/kpis/fte', formatter: 'formatter.formatNumber'}"
            scale="VZÄ"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Personalkosten"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{path: 'fakPersonal>/kpis/totalCost', formatter: 'formatter.formatNumber'}"
            scale="{path: 'fakPersonal>/kpis/totalCost', formatter: 'formatter.formatScale'}"
            valueColor="Error"/>
    </TileContent>

</GenericTile>


<!-- Statischer Platzhalterwert (nicht an ein Modell gebunden, da keine echte Berechnung dahinter steht) -->
<GenericTile
    header="Ø Kosten pro VZÄ"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="86.920"
            scale="€"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>

</HBox>

<VBox class="sapUiMediumMarginBegin sapUiMediumMarginEnd">

    <!-- Budgetaufstellung (Finanzen tab) – je Geschäftsjahr aus tableData>/budgetaufstellung -->
    <!--
      Zeigt Ausgaben (Sachmittel/Investitionen/Drittmittelprojekte) und Einnahmen
      (Landesmittel/Drittmittel/Erlöse/Erträge/Zinsen) inkl. Summenzeilen in EINER Tabelle;
      "rowType" (detail/total) steuert im Zeilen-Template die Fettschrift der Summenzeilen.
      Der Lehrstuhl-Filter rechnet die komplette Tabelle anteilig auf einen einzelnen
      Lehrstuhl herunter (siehe onLehrstuhlFilterChange/_updateTableData im Controller).
    -->
    <Table
        id="budgetBreakdown"
        items="{tableData>/budgetaufstellung}"
        visible="{= ${view>/selectedTab} === 'pr_fi' }"
        width="100%"
        inset="true">

		<headerToolbar>
        <Toolbar>

            <Title text="Budgetaufstellung"/>

            <ToolbarSpacer/>

            <!-- Filtert die gesamte Tabelle auf einen einzelnen Lehrstuhl (Anteil am Gesamtbudget) -->
            <Select
                id="lehrstuhlFilterSelect"
                change="onLehrstuhlFilterChange"
                selectedKey="alle"
                width="16rem"
                class="sapUiTinyMarginEnd">
                <items>
                    <core:Item key="alle" text="Alle Lehrstühle"/>
                    <core:Item key="Lehrstuhl Smart Services" text="Lehrstuhl Smart Services (Prof. Adam)"/>
                    <core:Item key="Lehrstuhl für E-Business" text="Lehrstuhl für E-Business (Prof. Schumann)"/>
                    <core:Item key="Lehrstuhl KI-Forschung" text="Lehrstuhl KI-Forschung (Prof. Weber)"/>
                    <core:Item key="Lehrstuhl Makroökonomik" text="Lehrstuhl Makroökonomik (Prof. Wagner)"/>
                    <core:Item key="Lehrstuhl International Finances" text="Lehrstuhl International Finances (Prof. Fischer)"/>
                    <core:Item key="Lehrstuhl Marketing" text="Lehrstuhl Marketing (Prof. Neumann)"/>
                </items>
            </Select>

            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Exportieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://action-settings"
                tooltip="Tabelleneinstellungen"
                type="Transparent"/>

        </Toolbar>
    </headerToolbar>

        <columns>
            <Column>
                <Text text="Bereich"/>
            </Column>

            <Column>
                <Text text="Position"/>
            </Column>

            <Column hAlign="End">
                <Text text="Budget"/>
            </Column>

            <Column hAlign="End">
                <Text text="Verausgabt"/>
            </Column>

            <Column hAlign="End">
                <Text text="Obligo"/>
            </Column>

            <Column hAlign="Center">
                <Text text="Verfügbar"/>
            </Column>
        </columns>


        <items>

            <!-- Ein Template für Detail- UND Summenzeilen; Fettschrift nur bei rowType === 'total' -->
            <ColumnListItem>
                <cells>

                    <Text
                        text="{tableData>bereich}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{tableData>position}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                </cells>
            </ColumnListItem>

        </items>

    </Table>

            <!-- WiWi-Fakultät allgemein (gleiche Stilistik wie Gebäude) -->
            <!--
              Nur im Reiter "Kostenstellen" sichtbar, oberhalb der Lehrstuhlübersicht.
              Zeigt die zentralen Verwaltungs-/Fakultätskostenstellen (Fakultät allgemein,
              Dekanat, Studiendekan, Forschungszentrum) inkl. Grundmittel-Übertragsregel
              (Übertragbar max. 20% / Verfällt an Zentralhaushalt). Jahresunabhängig, wie Gebäude.
            -->
            <Table
                id="wiwiAllgemeinBreakdown"
                items="{tableData>/wiwiAllgemein}"
                visible="{= ${view>/selectedTab} === 'pr_ks' }"
                width="100%"
                inset="true">

                <headerToolbar>
                    <Toolbar>
                        <Title text="WiWi-Fakultät allgemein"/>
                        <ToolbarSpacer/>

                        <Button
                            icon="sap-icon://excel-attachment"
                            tooltip="Exportieren"
                            type="Transparent"/>

                        <Button
                            icon="sap-icon://action-settings"
                            tooltip="Tabelleneinstellungen"
                            type="Transparent"/>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="Bereich"/></Column>
                    <Column><Text text="KostenstellenID"/></Column>
                    <Column hAlign="End"><Text text="Budget"/></Column>
                    <Column hAlign="End"><Text text="Verausgabt"/></Column>
                    <Column hAlign="End"><Text text="Obligo"/></Column>
                    <Column hAlign="End"><Text text="Verfügbar"/></Column>
                    <Column hAlign="End"><Text text="Übertragbar (max. 20%)"/></Column>
                    <Column hAlign="End"><Text text="Verfällt an Zentralhaushalt"/></Column>
                    <Column hAlign="Center"><Text text="Status"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{tableData>bereich}"/>
                            <Text text="{tableData>kostenstelleId}"/>
                            <Text text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>uebertragbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text
                                text="{path: 'tableData>verfaellt', formatter: 'formatter.formatEuroInt'}"
                                class="{= ${tableData>verfaellt} > 0 ? 'sapUiStrong' : '' }"/>
                            <Text text="{tableData>status}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>

            <!-- Lehrstuhlübersicht / Kostenstellen (gleiche Stilistik wie Budgetaufstellung) -->
            <!--
              Nur im Reiter "Kostenstellen" sichtbar. Zeigt alle Lehrstühle inkl. der
              Grundmittel-Übertragsregel (Übertragbar max. 20% / Verfällt an Zentralhaushalt).
              Nur der Lehrstuhl mit gesetzter "route" (aktuell KI-Forschung) ist klickbar/navigierbar
              (type="Navigation" vs. "Inactive" je nach ${tableData>route}).
              Durchsuchbar über das Suchfeld (onKostenstellenSearch filtert per Lehrstuhl-Namen).
            -->
            <Table
                id="lehrstuhlBreakdown"
                items="{tableData>/lehrstuehle}"
                visible="{= ${view>/selectedTab} === 'pr_ks' }"
                width="100%"
                inset="true">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Lehrstuhlübersicht"/>
						<ToolbarSpacer/>

            <SearchField
                width="15rem"
                placeholder="Lehrstuhl suchen"
                liveChange="onKostenstellenSearch"/>

            <Button
                icon="sap-icon://sort"
                tooltip="Sortieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Exportieren"
                type="Transparent"
                press=".onExport"/>

            <Button
                icon="sap-icon://action-settings"
                tooltip="Tabelleneinstellungen"
                type="Transparent"/>
                    </Toolbar>
                </headerToolbar>


                <columns>
                    <Column><Text text="Lehrstuhl"/></Column>
                    <Column><Text text="KostenstellenID"/></Column>
                    <Column hAlign="End"><Text text="Budget"/></Column>
                    <Column hAlign="End"><Text text="Verausgabt"/></Column>
                    <Column hAlign="End"><Text text="Obligo"/></Column>
                    <Column hAlign="End"><Text text="Verfügbar"/></Column>
                    <Column hAlign="End"><Text text="Übertragbar (max. 20%)"/></Column>
                    <Column hAlign="End"><Text text="Verfällt an Zentralhaushalt"/></Column>
                    <Column hAlign="Center"><Text text="Status"/></Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="{= ${tableData>route} ? 'Navigation' : 'Inactive' }"
                        press=".onLehrstuhlSelect">
                        <cells>
                            <ObjectIdentifier title="{tableData>lehrstuhl}" text="{tableData>professor}"/>
                            <Text text="{tableData>kostenstelleId}"/>
                            <Text text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>uebertragbar', formatter: 'formatter.formatEuroInt'}"/>
                            <!-- "Verfällt"-Betrag wird fett hervorgehoben, sobald er > 0 ist (Warnsignal) -->
                            <Text
                                text="{path: 'tableData>verfaellt', formatter: 'formatter.formatEuroInt'}"
                                class="{= ${tableData>verfaellt} > 0 ? 'sapUiStrong' : '' }"/>
                            <Text text="{tableData>status}"/>
                        </cells>
                    </ColumnListItem>

                </items>

            </Table>

            <!-- Gebäudebewirtschaftung (Kostenstellen der Fakultät nach Gebäude) -->
            <!--
              Gleiche Struktur/Logik wie die Lehrstuhlübersicht, nur für Gebäude-Kostenstellen.
              Titel bewusst "Gebäudebewirtschaftung" statt nur "Gebäude", um klarzustellen, dass
              dies Bewirtschaftungskostenstellen sind (Bau/Betrieb), keine Fakultätsbudgets im
              engeren Sinn.
            -->
            <Table
                id="gebaeudeBreakdown"
                items="{tableData>/gebaeude}"
                visible="{= ${view>/selectedTab} === 'pr_ks' }"
                width="100%"
                inset="true"
                class="sapUiMediumMarginTop">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Gebäudebewirtschaftung"/>
                        <ToolbarSpacer/>

                        <Button
                            icon="sap-icon://excel-attachment"
                            tooltip="Exportieren"
                            type="Transparent"/>

                        <Button
                            icon="sap-icon://action-settings"
                            tooltip="Tabelleneinstellungen"
                            type="Transparent"/>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="Gebäude"/></Column>
                    <Column><Text text="KostenstellenID"/></Column>
                    <Column hAlign="End"><Text text="Budget"/></Column>
                    <Column hAlign="End"><Text text="Verausgabt"/></Column>
                    <Column hAlign="End"><Text text="Obligo"/></Column>
                    <Column hAlign="End"><Text text="Verfügbar"/></Column>
                    <Column hAlign="End"><Text text="Übertragbar (max. 20%)"/></Column>
                    <Column hAlign="End"><Text text="Verfällt an Zentralhaushalt"/></Column>
                    <Column hAlign="Center"><Text text="Status"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{tableData>gebaeude}"/>
                            <Text text="{tableData>kostenstelleId}"/>
                            <Text text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>uebertragbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text
                                text="{path: 'tableData>verfaellt', formatter: 'formatter.formatEuroInt'}"
                                class="{= ${tableData>verfaellt} > 0 ? 'sapUiStrong' : '' }"/>
                            <Text text="{tableData>status}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>

            <!-- Finanzbewegungen (gleiche Stilistik) -->
            <!-- Einzelbuchungen je Geschäftsjahr (nur "Finanzen"-Reiter); Beträge mit Vorzeichen formatiert -->
            <Table
                id="finanzbewegungen"
                items="{tableData>/finanzbewegungen}"
                visible="{= ${view>/selectedTab} === 'pr_fi' }"
                width="100%"
                inset="true">

				<headerToolbar>
					<Toolbar>

						<Title text="Finanzbewegungen"/>

						<ToolbarSpacer/>

						<SearchField
							width="15rem"
							placeholder="Buchung suchen"/>

						<Button
							icon="sap-icon://sort"
							tooltip="Sortieren"
							type="Transparent"/>

						<Button
							icon="sap-icon://filter"
							tooltip="Filter"
							type="Transparent"/>

						<Button
							icon="sap-icon://excel-attachment"
							tooltip="Exportieren"
							type="Transparent"/>

						<Button
							icon="sap-icon://action-settings"
							tooltip="Tabelleneinstellungen"
							type="Transparent"/>

					</Toolbar>
				</headerToolbar>

                <columns>
                    <Column><Text text="Datum"/></Column>
                    <Column><Text text="Lehrstuhl"/></Column>
                    <Column><Text text="Buchung"/></Column>
                    <Column><Text text="Projekt/Kostenstelle"/></Column>
                    <Column><Text text="Typ"/></Column>
                    <Column><Text text="Betrag"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{tableData>datum}"/>
                            <Text text="{tableData>lehrstuhl}"/>
                            <Text text="{tableData>buchung}"/>
                            <Text text="{tableData>kostenstelle}"/>
                            <Text text="{tableData>typ}"/>
                            <Text text="{path: 'tableData>betrag', formatter: 'formatter.formatSignedEuro'}" class="sapUiMonospace"/>
                        </cells>
                    </ColumnListItem>

                </items>

            </Table>

            <!--
              Personalbindung & Einsatz (nur "Personal"-Reiter): vollständig statische
              Beispieldaten (nicht an /api/personal gebunden), zeigt Name/Rolle/Finanzierungsart/
              Zeitraum/VZÄ/Jahreskosten/Status je Person.
            -->
            <Table
                id="personalDetail"
                visible="{= ${view>/selectedTab} === 'pr_hr' }"
                width="100%"
                inset="true">


				    <headerToolbar>
        <Toolbar>

            <Title text="Personalbindung &amp; Einsatz"/>

            <ToolbarSpacer/>

            <SearchField
                width="15rem"
                placeholder="Person suchen"/>

            <Button
                icon="sap-icon://sort"
                tooltip="Sortieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://filter"
                tooltip="Filter"
                type="Transparent"/>

            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Exportieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://action-settings"
                tooltip="Tabelleneinstellungen"
                type="Transparent"/>

        </Toolbar>
    </headerToolbar>

                <columns>
                    <Column><Text text="Name"/></Column>
                    <Column><Text text="Rolle"/></Column>
                    <Column><Text text="Finanzierung"/></Column>
                    <Column><Text text="Von"/></Column>
