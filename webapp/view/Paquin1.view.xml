<mvc:View
	controllerName="de.unigoettingen.dashboardapp.controller.Paquin1"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
		core:require="{
		formatter: 'de/unigoettingen/dashboardapp/model/formatter'
	}">

	<Page
		id="paquin1Page"
		showNavButton="false">

		<customHeader>
			<Bar>
				<contentLeft>
					<HBox alignItems="Center">
						<core:Icon src="sap-icon://education" size="1rem" class="sapUiTinyMarginEnd"/>
						<Title text="Fakultätsfinanzen" class="sapUiTinyMarginTop"/>
					</HBox>
				</contentLeft>

				<contentMiddle>
					<IconTabHeader id="navTabBar" selectedKey="pr_fi" select="onTabSelect">
						<items>
							<IconTabFilter text="Finanzen" key="pr_fi"/>
							<IconTabFilter text="Personal" key="pr_hr"/>
							<IconTabFilter text="Kostenstellen" key="pr_ks"/>
						</items>
					</IconTabHeader>
				</contentMiddle>

				<contentRight>
					<Button
						id="lehrstuhlMenuButton"
						text="Lehrstuhl"
						icon="sap-icon://education"
						press="onLehrstuhlMenuPress"
						class="sapUiTinyMarginEnd"/>

					<!-- Jahresauswahl -->
					<Select change="onYearChange" class="sapUiSmallMargin">
						<items>
							<core:Item key="2024" text="2024"/>
							<core:Item key="2025" text="2025"/>
							<core:Item key="2026" text="2026"/>
						</items>
					</Select>
				</contentRight>
			</Bar>
		</customHeader>

		<content>

			<!--- KPI-Karten: Kontoübersicht -->
			<HBox justifyContent="SpaceAround" class="sapUiSmallMargin" wrap="Wrap" visible="{= ${view>/selectedTab} === 'pr_fi' }">

    <GenericTile
    header="Budget"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
            parts: [
                { path: 'fakFinanzen>/kpis/budget' },
                { path: 'fakFinanzen>/kpis/prevBudget' }
            ],
            formatter: 'formatter.formatBudgetFooter'
        }">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/budget',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/budget',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Verausgabt"
    class="sapUiTinyMargin">

    <TileContent
        footer="82,4% verausgabt">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/ausgabenIst',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/ausgabenIst',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Error"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Obligo"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
			parts: [
				{ path: 'fakFinanzen>/kpis/obligo' },
				{ path: 'fakFinanzen>/kpis/budget' }
			],
			formatter: 'formatter.formatObligoFooter'
		}">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/obligo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/obligo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Critical"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Verfügbar"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
			parts: [
				{ path: 'fakFinanzen>/kpis/restVerfuegbarkeit' },
				{ path: 'fakFinanzen>/kpis/budget' }
			],
			formatter: 'formatter.formatRestFooter'
		}">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/restVerfuegbarkeit',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/restVerfuegbarkeit',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Good"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Grundmittel"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
            path: 'budgetarten>/grundmittel/saldo',
            formatter: 'formatter.formatBudgetartStatus'
        }">

        <NumericContent
            value="{
                path: 'budgetarten>/grundmittel/saldo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'budgetarten>/grundmittel/saldo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="{
                path: 'budgetarten>/grundmittel/saldo',
                formatter: 'formatter.formatBudgetartColor'
            }"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Drittmittel"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
            path: 'budgetarten>/drittmittel/saldo',
            formatter: 'formatter.formatBudgetartStatus'
        }">

        <NumericContent
            value="{
                path: 'budgetarten>/drittmittel/saldo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'budgetarten>/drittmittel/saldo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="{
                path: 'budgetarten>/drittmittel/saldo',
                formatter: 'formatter.formatBudgetartColor'
            }"/>
    </TileContent>

</GenericTile>

</HBox>

			<HBox justifyContent="SpaceAround" class="sapUiSmallMargin" wrap="Wrap" visible="{= ${view>/selectedTab} === 'pr_hr' }">

    <GenericTile
    header="Kopfzahl (Gesamt)"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{fakPersonal>/kpis/headcount}"
            scale="Personen"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Personalbestand (VZÄ)"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{path: 'fakPersonal>/kpis/fte', formatter: 'formatter.formatNumber'}"
            scale="VZÄ"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Personalkosten"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{path: 'fakPersonal>/kpis/totalCost', formatter: 'formatter.formatNumber'}"
            scale="{path: 'fakPersonal>/kpis/totalCost', formatter: 'formatter.formatScale'}"
            valueColor="Error"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Ø Kosten pro VZÄ"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="86.920"
            scale="€"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>

</HBox>

<VBox class="sapUiMediumMarginBegin sapUiMediumMarginEnd">

    <!-- Budgetaufstellung (Finanzen tab) – je Geschäftsjahr aus tableData>/budgetaufstellung -->
    <Table
        id="budgetBreakdown"
        items="{tableData>/budgetaufstellung}"
        visible="{= ${view>/selectedTab} === 'pr_fi' }"
        width="100%"
        inset="true">

		<headerToolbar>
        <Toolbar>

            <Title text="Budgetaufstellung"/>

            <ToolbarSpacer/>

            <Select
                id="lehrstuhlFilterSelect"
                change="onLehrstuhlFilterChange"
                selectedKey="alle"
                width="16rem"
                class="sapUiTinyMarginEnd">
                <items>
                    <core:Item key="alle" text="Alle Lehrstühle"/>
                    <core:Item key="Lehrstuhl Smart Services" text="Lehrstuhl Smart Services (Prof. Adam)"/>
                    <core:Item key="Lehrstuhl für E-Business" text="Lehrstuhl für E-Business (Prof. Schumann)"/>
                    <core:Item key="Lehrstuhl KI-Forschung" text="Lehrstuhl KI-Forschung (Prof. Weber)"/>
                    <core:Item key="Lehrstuhl Makroökonomik" text="Lehrstuhl Makroökonomik (Prof. Wagner)"/>
                    <core:Item key="Lehrstuhl International Finances" text="Lehrstuhl International Finances (Prof. Fischer)"/>
                    <core:Item key="Lehrstuhl Marketing" text="Lehrstuhl Marketing (Prof. Neumann)"/>
                </items>
            </Select>

            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Exportieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://action-settings"
                tooltip="Tabelleneinstellungen"
                type="Transparent"/>

        </Toolbar>
    </headerToolbar>

        <columns>
            <Column>
                <Text text="Bereich"/>
            </Column>

            <Column>
                <Text text="Position"/>
            </Column>

            <Column hAlign="End">
                <Text text="Budget"/>
            </Column>

            <Column hAlign="End">
                <Text text="Obligo"/>
            </Column>

            <Column hAlign="End">
                <Text text="Verausgabt"/>
            </Column>

            <Column hAlign="Center">
                <Text text="Verfügbar"/>
            </Column>
        </columns>


        <items>

            <ColumnListItem>
                <cells>

                    <Text
                        text="{tableData>bereich}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{tableData>position}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                    <Text
                        text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"
                        class="{= ${tableData>rowType} === 'total' ? 'sapUiStrong' : '' }"/>

                </cells>
            </ColumnListItem>

        </items>

    </Table>

            <!-- Lehrstuhlübersicht / Kostenstellen (gleiche Stilistik wie Budgetaufstellung) -->
            <Table
                id="lehrstuhlBreakdown"
                items="{tableData>/lehrstuehle}"
                visible="{= ${view>/selectedTab} === 'pr_ks' }"
                width="100%"
                inset="true">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Lehrstuhlübersicht"/>
						<ToolbarSpacer/>

            <SearchField
                width="15rem"
                placeholder="Lehrstuhl suchen"
                liveChange="onKostenstellenSearch"/>

            <Button
                icon="sap-icon://sort"
                tooltip="Sortieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Exportieren"
                type="Transparent"
                press=".onExport"/>

            <Button
                icon="sap-icon://action-settings"
                tooltip="Tabelleneinstellungen"
                type="Transparent"/>
                    </Toolbar>
                </headerToolbar>
				

                <columns>
                    <Column><Text text="Lehrstuhl"/></Column>
                    <Column><Text text="KostenstellenID"/></Column>
                    <Column hAlign="End"><Text text="Budget"/></Column>
                    <Column hAlign="End"><Text text="Verausgabt"/></Column>
                    <Column hAlign="End"><Text text="Obligo"/></Column>
                    <Column hAlign="End"><Text text="Verfügbar"/></Column>
                    <Column hAlign="End"><Text text="Übertragbar (max. 20%)"/></Column>
                    <Column hAlign="End"><Text text="Verfällt an Zentralhaushalt"/></Column>
                    <Column hAlign="Center"><Text text="Status"/></Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="{= ${tableData>route} ? 'Navigation' : 'Inactive' }"
                        press=".onLehrstuhlSelect">
                        <cells>
                            <ObjectIdentifier title="{tableData>lehrstuhl}" text="{tableData>professor}"/>
                            <Text text="{tableData>kostenstelleId}"/>
                            <Text text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>uebertragbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text
                                text="{path: 'tableData>verfaellt', formatter: 'formatter.formatEuroInt'}"
                                class="{= ${tableData>verfaellt} > 0 ? 'sapUiStrong' : '' }"/>
                            <Text text="{tableData>status}"/>
                        </cells>
                    </ColumnListItem>

                </items>

            </Table>

            <!-- Gebäude (Kostenstellen der Fakultät nach Gebäude) -->
            <Table
                id="gebaeudeBreakdown"
                items="{tableData>/gebaeude}"
                visible="{= ${view>/selectedTab} === 'pr_ks' }"
                width="100%"
                inset="true"
                class="sapUiMediumMarginTop">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Gebäude"/>
                        <ToolbarSpacer/>

                        <Button
                            icon="sap-icon://excel-attachment"
                            tooltip="Exportieren"
                            type="Transparent"/>

                        <Button
                            icon="sap-icon://action-settings"
                            tooltip="Tabelleneinstellungen"
                            type="Transparent"/>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="Gebäude"/></Column>
                    <Column><Text text="KostenstellenID"/></Column>
                    <Column hAlign="End"><Text text="Budget"/></Column>
                    <Column hAlign="End"><Text text="Verausgabt"/></Column>
                    <Column hAlign="End"><Text text="Obligo"/></Column>
                    <Column hAlign="End"><Text text="Verfügbar"/></Column>
                    <Column hAlign="End"><Text text="Übertragbar (max. 20%)"/></Column>
                    <Column hAlign="End"><Text text="Verfällt an Zentralhaushalt"/></Column>
                    <Column hAlign="Center"><Text text="Status"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{tableData>gebaeude}"/>
                            <Text text="{tableData>kostenstelleId}"/>
                            <Text text="{path: 'tableData>budget', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verausgabt', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>obligo', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>verfuegbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text text="{path: 'tableData>uebertragbar', formatter: 'formatter.formatEuroInt'}"/>
                            <Text
                                text="{path: 'tableData>verfaellt', formatter: 'formatter.formatEuroInt'}"
                                class="{= ${tableData>verfaellt} > 0 ? 'sapUiStrong' : '' }"/>
                            <Text text="{tableData>status}"/>
                        </cells>
                    </ColumnListItem>
                </items>

            </Table>

            <!-- Finanzbewegungen (gleiche Stilistik) -->
            <Table
                id="finanzbewegungen"
                items="{tableData>/finanzbewegungen}"
                visible="{= ${view>/selectedTab} === 'pr_fi' }"
                width="100%"
                inset="true">

				<headerToolbar>
					<Toolbar>

						<Title text="Finanzbewegungen"/>

						<ToolbarSpacer/>

						<SearchField
							width="15rem"
							placeholder="Buchung suchen"/>

						<Button
							icon="sap-icon://sort"
							tooltip="Sortieren"
							type="Transparent"/>

						<Button
							icon="sap-icon://filter"
							tooltip="Filter"
							type="Transparent"/>

						<Button
							icon="sap-icon://excel-attachment"
							tooltip="Exportieren"
							type="Transparent"/>

						<Button
							icon="sap-icon://action-settings"
							tooltip="Tabelleneinstellungen"
							type="Transparent"/>

					</Toolbar>
				</headerToolbar>

                <columns>
                    <Column><Text text="Datum"/></Column>
                    <Column><Text text="Lehrstuhl"/></Column>
                    <Column><Text text="Buchung"/></Column>
                    <Column><Text text="Projekt/Kostenstelle"/></Column>
                    <Column><Text text="Typ"/></Column>
                    <Column><Text text="Betrag"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{tableData>datum}"/>
                            <Text text="{tableData>lehrstuhl}"/>
                            <Text text="{tableData>buchung}"/>
                            <Text text="{tableData>kostenstelle}"/>
                            <Text text="{tableData>typ}"/>
                            <Text text="{path: 'tableData>betrag', formatter: 'formatter.formatSignedEuro'}" class="sapUiMonospace"/>
                        </cells>
                    </ColumnListItem>

                </items>

            </Table>

            <Table
                id="personalDetail"
                visible="{= ${view>/selectedTab} === 'pr_hr' }"
                width="100%"
                inset="true">


				    <headerToolbar>
        <Toolbar>

            <Title text="Personalbindung &amp; Einsatz"/>

            <ToolbarSpacer/>

            <SearchField
                width="15rem"
                placeholder="Person suchen"/>

            <Button
                icon="sap-icon://sort"
                tooltip="Sortieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://filter"
                tooltip="Filter"
                type="Transparent"/>

            <Button
                icon="sap-icon://excel-attachment"
                tooltip="Exportieren"
                type="Transparent"/>

            <Button
                icon="sap-icon://action-settings"
                tooltip="Tabelleneinstellungen"
                type="Transparent"/>

        </Toolbar>
    </headerToolbar>

                <columns>
                    <Column><Text text="Name"/></Column>
                    <Column><Text text="Rolle"/></Column>
                    <Column><Text text="Finanzierung"/></Column>
                    <Column><Text text="Von"/></Column>
                    <Column><Text text="Bis"/></Column>
                    <Column hAlign="End"><Text text="VZÄ"/></Column>
                    <Column hAlign="End"><Text text="Jahreskosten"/></Column>
                    <Column><Text text="Status"/></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="Dr. Jana Becker"/>
                            <Text text="Projektleitung"/>
                            <Text text="Drittmittel"/>
                            <Text text="01.02.2026"/>
                            <Text text="31.01.2027"/>
                            <Text text="0,75"/>
                            <ObjectNumber number="72000" unit="€"/>
                            <ObjectStatus text="Aktiv" state="Success"/>
                        </cells>
                    </ColumnListItem>

                    <ColumnListItem>
                        <cells>
                            <Text text="M.Sc. Paul Klein"/>
                            <Text text="Lehre"/>
                            <Text text="Grundmittel"/>
                            <Text text="01.10.2025"/>
                            <Text text="30.09.2026"/>
                            <Text text="0,50"/>
                            <ObjectNumber number="38000" unit="€"/>
                            <ObjectStatus text="Aktiv" state="Success"/>
                        </cells>
                    </ColumnListItem>

                    <ColumnListItem>
                        <cells>
                            <Text text="M.Sc. Lena Schmidt"/>
                            <Text text="Forschung"/>
                            <Text text="Drittmittel"/>
                            <Text text="15.03.2026"/>
                            <Text text="14.03.2027"/>
                            <Text text="0,60"/>
                            <ObjectNumber number="45000" unit="€"/>
                            <ObjectStatus text="Geplant" state="Warning"/>
                        </cells>
                    </ColumnListItem>

                    <ColumnListItem>
                        <cells>
                            <Text text="Dr. Markus Braun"/>
                            <Text text="Verwaltung"/>
                            <Text text="Grundmittel"/>
                            <Text text="01.01.2026"/>
                            <Text text="31.12.2026"/>
                            <Text text="0,40"/>
                            <ObjectNumber number="33000" unit="€"/>
                            <ObjectStatus text="Aktiv" state="Success"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>

</VBox>
		</content>

	</Page>

</mvc:View>
