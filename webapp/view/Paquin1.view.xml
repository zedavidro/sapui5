<mvc:View
	controllerName="de.unigoettingen.dashboardapp.controller.Paquin1"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
		core:require="{
		formatter: 'de/unigoettingen/dashboardapp/model/formatter'
	}">

	<Page
		id="paquin1Page"
		showNavButton="false">

		<customHeader>
			<Bar>
				<contentLeft>
					<HBox alignItems="Center">
						<core:Icon src="sap-icon://education" size="1rem" class="sapUiTinyMarginEnd"/>
						<Title text="Fakultätsfinanzen" class="sapUiTinyMarginTop"/>
					</HBox>
				</contentLeft>

				<contentMiddle>
					<IconTabHeader id="navTabBar" selectedKey="pr_fi" select="onTabSelect">
						<items>
							<IconTabFilter text="Finanzen" key="pr_fi"/>
							<IconTabFilter text="Personal" key="pr_hr"/>
						</items>
					</IconTabHeader>
				</contentMiddle>

				<contentRight>
					<Button
						id="lehrstuhlMenuButton"
						text="Lehrstuhl"
						icon="sap-icon://education"
						press="onLehrstuhlMenuPress"
						class="sapUiTinyMarginEnd"/>

					<!-- Jahresauswahl -->
					<Select change="onYearChange" class="sapUiSmallMargin">
						<items>
							<core:Item key="2024" text="2024"/>
							<core:Item key="2025" text="2025"/>
							<core:Item key="2026" text="2026"/>
						</items>
					</Select>
				</contentRight>
			</Bar>
		</customHeader>

		<content>

			<!--- KPI-Karten: Kontoübersicht -->
			<HBox justifyContent="SpaceAround" class="sapUiSmallMargin" wrap="Wrap" visible="{= ${view>/selectedTab} === 'pr_fi' }">

    <GenericTile
    header="Budget"
    class="sapUiTinyMargin">

    <TileContent
        footer="+3,8% ggü. Vorjahr">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/budget',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/budget',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Verausgabt"
    class="sapUiTinyMargin">

    <TileContent
        footer="82,4% verausgabt">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/ausgabenIst',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/ausgabenIst',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Error"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Obligo"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
			parts: [
				{ path: 'fakFinanzen>/kpis/obligo' },
				{ path: 'fakFinanzen>/kpis/budget' }
			],
			formatter: 'formatter.formatObligoFooter'
		}">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/obligo',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/obligo',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Critical"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Verfügbar"
    class="sapUiTinyMargin">

    <TileContent
        footer="{
			parts: [
				{ path: 'fakFinanzen>/kpis/restVerfuegbarkeit' },
				{ path: 'fakFinanzen>/kpis/budget' }
			],
			formatter: 'formatter.formatRestFooter'
		}">

        <NumericContent
            value="{
                path: 'fakFinanzen>/kpis/restVerfuegbarkeit',
                formatter: 'formatter.formatNumber'
            }"
            scale="{
                path: 'fakFinanzen>/kpis/restVerfuegbarkeit',
                formatter: 'formatter.formatScale'
            }"
            valueColor="Good"/>
    </TileContent>

</GenericTile>

</HBox>

			<HBox justifyContent="SpaceAround" class="sapUiSmallMargin" wrap="Wrap" visible="{= ${view>/selectedTab} === 'pr_hr' }">

    <GenericTile
    header="Kopfzahl (Gesamt)"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{fakPersonal>/kpis/headcount}"
            scale="Personen"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Personalbestand (VZÄ)"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{path: 'fakPersonal>/kpis/fte', formatter: 'formatter.formatNumber'}"
            scale="VZÄ"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Personalkosten"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="{path: 'fakPersonal>/kpis/totalCost', formatter: 'formatter.formatNumber'}"
            scale="{path: 'fakPersonal>/kpis/totalCost', formatter: 'formatter.formatScale'}"
            valueColor="Error"/>
    </TileContent>

</GenericTile>


<GenericTile
    header="Ø Kosten pro VZÄ"
    class="sapUiTinyMargin">

    <TileContent>

        <NumericContent
            value="86.920"
            scale="€"
            valueColor="Neutral"/>
    </TileContent>

</GenericTile>

</HBox>

