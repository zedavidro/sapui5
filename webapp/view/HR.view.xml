<!--
  HR.view.xml — Personal-Seite auf Lehrstuhlebene (Route "hr")
  - Zeigt Kennzahlen (Kopfzahl, VZÄ, Personalkosten) und mehrere Diagramme zur Personalstruktur
  - Daten kommen aus /api/personal (echte SQLite-Tabelle) und werden im Controller
    (HR.controller.js) aggregiert und in Diagramm-taugliche Datensätze umgewandelt
  - Zwei Reiter: "Struktur & Befristung" (Verteilung, Geschlecht, Befristungsende, Alter)
    und "Personalkosten-Controlling" (Kosten nach Dienstart/Struktureinheit)
-->
<mvc:View
  controllerName="de.unigoettingen.dashboardapp.controller.HR"
  displayBlock="true"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:viz.data="sap.viz.ui5.data"
  xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
  core:require="{ formatter: 'de/unigoettingen/dashboardapp/model/formatter' }">

  <Page
    id="page"
    showHeader="false">

    <content>
      <!-- Jahresauswahl: löst onYearChange aus, das die komplette Aggregation neu berechnet -->
      <Toolbar design="Transparent" class="sapUiSmallMargin">
        <Title text="Analysejahr wählen:" class="sapUiTinyMarginEnd"/>
        <Select change="onYearChange" selectedKey="2025">
          <items>
            <core:Item key="2024" text="2024"/>
            <core:Item key="2025" text="2025"/>
            <core:Item key="2026" text="2026"/>
            <core:Item key="alle" text="alle"/>
          </items>
        </Select>
      </Toolbar>

      <!-- KPI-Kacheln: gebunden an das Modell "dashboard" (siehe _updateAggregates im Controller) -->
      <HBox justifyContent="SpaceAround" class="sapUiSmallMargin sapUiLargeMarginBottom">
        <GenericTile header="Kopfzahl (Gesamt)" class="sapUiTinyMargin">
          <TileContent>
            <NumericContent
              value="{dashboard>/kpis/headcount}"
              scale="Personen"
              valueColor="Neutral" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Vollzeitäquivalente (VZÄ)" class="sapUiTinyMargin">
          <TileContent>
            <NumericContent
              value="{dashboard>/kpis/fte}"
              scale="VZÄ"
              valueColor="Neutral" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Personalkosten (Hochrechnung)" class="sapUiTinyMargin">
          <TileContent>
            <NumericContent
              value="{path: 'dashboard>/kpis/totalCost', formatter: 'formatter.formatNumber'}"
              scale="{path: 'dashboard>/kpis/totalCost', formatter: 'formatter.formatScale'}"
              valueColor="Error"
              size="L" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Ø Kosten pro VZÄ" class="sapUiTinyMargin">
          <TileContent>
            <NumericContent
              value="{path: 'dashboard>/kpis/avgCostPerFTE', formatter: 'formatter.formatNumber'}"
              scale="{path: 'dashboard>/kpis/avgCostPerFTE', formatter: 'formatter.formatScale'}"
              valueColor="Neutral"
              size="L" />
          </TileContent>
        </GenericTile>
      </HBox>

      <!--
        Zwei Reiter mit jeweils eigenen Diagrammen.
        id="idHRIconTabBar" wird im Controller für den animierten Auswahl-Schieber
        (_updateHRTabSlider) benötigt.
      -->
      <IconTabBar id="idHRIconTabBar" select="onHRTabSelect" upperCase="true" class="sapUiResponsiveContentPadding">
        <items>

          <!-- Reiter 1: Struktur & Befristung -->
          <IconTabFilter icon="sap-icon://employee" text="Struktur &amp; Befristung" key="structure">
            <content>

              <HBox justifyContent="SpaceBetween" width="100%">
                <!-- Säulendiagramm: Anzahl Mitarbeitende je Dienstart -->
                <VBox width="49%">
                  <viz:VizFrame
                    id="idPersonalPieChart"
                    vizType="column"
                    width="100%"
                    height="350px"
                    vizProperties="{
                      title: { text: 'Verteilung nach Dienstart', visible: true },
                      legend: { visible: false }
                    }">
                    <viz:dataset>
                      <viz.data:FlattenedDataset data="{/employeeGroups}">
                        <viz.data:dimensions>
                          <viz.data:DimensionDefinition name="Dienstart" value="{name}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                          <viz.data:MeasureDefinition name="Anzahl" value="{value}" />
                        </viz.data:measures>
                      </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                      <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Anzahl"/>
                      <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Dienstart"/>
                    </viz:feeds>
                  </viz:VizFrame>
                </VBox>

                <!-- Gestapeltes Säulendiagramm: Dienstart x Geschlecht -->
                <VBox width="49%">
                  <viz:VizFrame
                    id="idStackedBarChart"
                    vizType="stacked_column"
                    width="100%"
                    height="350px"
                    vizProperties="{ title: { text: 'Mitarbeiter nach Dienstart und Geschlecht', visible: true } }">
                    <viz:dataset>
                      <viz.data:FlattenedDataset data="{/stackedData}">
                        <viz.data:dimensions>
                          <viz.data:DimensionDefinition name="Dienstart" value="{finArt}" />
                          <viz.data:DimensionDefinition name="Geschlecht" value="{gesch}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                          <viz.data:MeasureDefinition name="Anzahl" value="{count}" />
                        </viz.data:measures>
                      </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                      <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Anzahl"/>
                      <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Dienstart"/>
                      <viz.feeds:FeedItem uid="color" type="Dimension" values="Geschlecht"/>
                    </viz:feeds>
                  </viz:VizFrame>
                </VBox>
              </HBox>

              <!--
                Balkendiagramm "Befristungs-Radar": ein Punkt pro Mitarbeiter*in, x-Achse =
                Jahr des Vertragsendes. Die Farb-/Referenzlinien-Einstellungen (heutiges Datum,
                Teilzeit/Vollzeit-Farben) werden zusätzlich im Controller (onInit) gesetzt,
                da sie vom aktuellen Datum abhängen und nicht statisch in der XML stehen können.
              -->
              <viz:VizFrame
                id="idContractEndRadar"
                vizType="bar"
                width="100%"
                height="500px"
                class="sapUiLargeMarginTop"
                vizProperties="{
                  title: { text: 'Befristungs-Radar: Ablauf der Verträge (Enddatum)', visible: true },
                  plotArea: {
                    dataPointStyle: {
                      rules: [
                        {
                          dataContext: { 'VZÄ': '0.5' },
                          properties: {
                            color: '#f87171'
                          },
                          displayName: 'Teilzeit (0.5 VZÄ)'
                        },
                        {
                          dataContext: { 'VZÄ': '1.0' },
                          properties: {
                            color: '#818cf8'
                          },
                          displayName: 'Vollzeit (1.0 VZÄ)'
                        }
                      ]
                    }
                  },
                  valueAxis: {
                    title: { text: 'Jahr des Vertragsendes' },
                    scale: {
                      fixedRange: true,
                      minValue: 2015,
                      maxValue: 2032
                    },
                    label: {
                      formatString: '0'
                    }
                  },
                  categoryAxis: { title: { text: 'Mitarbeiter (Code)' } }
                }">
                <viz:dataset>
                  <viz.data:FlattenedDataset data="{/contractTimelineData}">
                    <viz.data:dimensions>
                      <viz.data:DimensionDefinition name="Mitarbeiter" value="{empCode}" />
                      <viz.data:DimensionDefinition name="VZÄ" value="{vzaeStr}" />
                    </viz.data:dimensions>
                    <viz.data:measures>
                      <viz.data:MeasureDefinition name="Vertragsende" value="{endYear}" />
                    </viz.data:measures>
                  </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                  <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Vertragsende"/>
                  <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Mitarbeiter,VZÄ"/>
                </viz:feeds>
              </viz:VizFrame>

              <!-- Gestapeltes Säulendiagramm: Altersstruktur nach Dienstart -->
              <viz:VizFrame
                id="idAgeStructureChart"
                vizType="stacked_column"
                width="100%"
                height="350px"
                class="sapUiLargeMarginTop"
                vizProperties="{
                  title: { text: 'Altersstruktur', visible: true },
                  valueAxis: { title: { text: 'Kopfzahl (Personen)' } },
                  categoryAxis: { title: { text: 'Altersgruppe' } }
                }">
                <viz:dataset>
                  <viz.data:FlattenedDataset data="{/ageStructureData}">
                    <viz.data:dimensions>
                      <viz.data:DimensionDefinition name="Altersgruppe" value="{ageGroup}" />
                      <viz.data:DimensionDefinition name="Dienstart" value="{finArt}" />
                    </viz.data:dimensions>
                    <viz.data:measures>
                      <viz.data:MeasureDefinition name="Kopfzahl" value="{headcount}" />
                    </viz.data:measures>
                  </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                  <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Kopfzahl"/>
                  <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Altersgruppe"/>
                  <viz.feeds:FeedItem uid="color" type="Dimension" values="Dienstart"/>
                </viz:feeds>
              </viz:VizFrame>

            </content>
          </IconTabFilter>

          <!-- Reiter 2: Personalkosten-Controlling -->
          <IconTabFilter icon="sap-icon://lead" text="Personalkosten-Controlling" key="costs">
            <content>

              <HBox justifyContent="SpaceBetween" width="100%">
                <!-- Kosten nach Personalgruppe (Dienstart) -->
                <VBox width="49%">
                  <viz:VizFrame
                    id="idCostByFinArtChart"
                    vizType="column"
                    width="100%"
                    height="380px"
                    vizProperties="{
                      title: { text: 'Personalkosten nach Personalgruppe', visible: true },
                      valueAxis: { title: { text: 'Kosten in EUR' } },
                      categoryAxis: { title: { text: 'Dienstart' } },
                      legend: { visible: false }
                    }">
                    <viz:dataset>
                      <viz.data:FlattenedDataset data="{/costByFinArt}">
                        <viz.data:dimensions>
                          <viz.data:DimensionDefinition name="Dienstart" value="{finArt}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                          <viz.data:MeasureDefinition name="Kosten" value="{cost}" />
                        </viz.data:measures>
                      </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                      <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Kosten"/>
                      <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Dienstart"/>
                    </viz:feeds>
                  </viz:VizFrame>
                </VBox>

                <!-- Kosten nach Struktureinheit / Institut -->
                <VBox width="49%">
                  <viz:VizFrame
                    id="idCostByOrgChart"
                    vizType="column"
                    width="100%"
                    height="380px"
                    vizProperties="{
                      title: { text: 'Kostenverteilung nach Struktureinheit / Institut', visible: true },
                      valueAxis: { title: { text: 'Kosten in EUR' } },
                      categoryAxis: { title: { text: 'Abteilung' } },
                      legend: { visible: false }
                    }">
                    <viz:dataset>
                      <viz.data:FlattenedDataset data="{/costByOrg}">
                        <viz.data:dimensions>
                          <viz.data:DimensionDefinition name="Abteilung" value="{org}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                          <viz.data:MeasureDefinition name="Kosten" value="{cost}" />
                        </viz.data:measures>
                      </viz.data:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                      <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Kosten"/>
                      <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Abteilung"/>
                    </viz:feeds>
                  </viz:VizFrame>
                </VBox>
              </HBox>

            </content>
          </IconTabFilter>

        </items>
      </IconTabBar>

    </content>
  </Page>
</mvc:View>
